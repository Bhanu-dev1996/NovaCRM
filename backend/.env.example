PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Postgres URI (Project Settings → Database → Connect → URI)
# Example (include sslmode=require):
# postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Optional: override countries API (defaults to https://countries.dev/countries)
# COUNTRIES_API_URL=

# —— Verification email (required for inbox delivery) ——
# Option A: Resend (https://resend.com → API Keys)
RESEND_API_KEY=
# Optional from address. Resend test default: NovaCRM <onboarding@resend.dev>
# With the test sender, mail can only go to the email on your Resend account.
# For any recipient, verify a domain in Resend and set EMAIL_FROM=NovaCRM <noreply@yourdomain.com>
EMAIL_FROM=

# Local testing without a verified domain: show the verify link in the app UI
# when Resend's test sender can't deliver to other inboxes (default: on for localhost)
EMAIL_DEV_LINKS=true

# Option B: SMTP (e.g. Gmail app password) — used when RESEND_API_KEY is empty
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=NovaCRM <you@gmail.com>
